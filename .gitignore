# 1. Ignore raw jars, but ALLOW tracking of the mod index metadata
/mods/*.jar
/mods/**/*.jar
!/mods/.index/
!/mods/.index/**

resourcepacks/**/*.zip
resourcepacks/*.zip
shaderpacks/**/*.zip
shaderpacks/*.zip

